# Origin of the backend API. Leave unset for local development so Vite's dev
# proxy forwards /api to localhost:8080.
#
# In a deployment set this to the backend's origin, with or without a scheme:
#   VITE_API_BASE_URL=https://schema-vc-api.onrender.com
#
# Vite inlines this at BUILD time, so changing it requires a rebuild.
VITE_API_BASE_URL=
